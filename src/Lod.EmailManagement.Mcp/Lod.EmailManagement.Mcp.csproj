<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lod.EmailManagement.Mcp</RootNamespace>
    <AssemblyName>Lod.EmailManagement.Mcp</AssemblyName>
    <Product>Email Management MCP</Product>
    <Company>Lod Softworks LLC</Company>
    <Copyright>Copyright © Lod Softworks LLC</Copyright>
    <Description>ASP.NET Core API providing a Model Context Protocol (MCP) and REST interface for email management via IMAP/SMTP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

</Project>
