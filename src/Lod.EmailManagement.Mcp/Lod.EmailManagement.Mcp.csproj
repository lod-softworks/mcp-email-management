<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lod.EmailManagement.Mcp</RootNamespace>
    <AssemblyName>Lod.EmailManagement.Mcp</AssemblyName>
    <Product>Email Management MCP</Product>
    <Company>Lod Softworks LLC</Company>
    <Copyright>Copyright © Lod Softworks LLC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>ASP.NET Core service providing a Model Context Protocol (MCP) server for email management via IMAP/SMTP.</Description>
    <UserSecretsId>email-mcp-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lod.EmailManagement.Mcp.Tests" />
  </ItemGroup>

</Project>
